{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blokctl.dev/schemas/space-setup.schema.json",
  "title": "blokctl Space Setup Configuration",
  "description": "Configuration used by blokctl space:setup.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "description": "Configuration schema version.",
      "const": 1
    },
    "continue_on_error": {
      "description": "Continue running setup steps after a failed step.",
      "$ref": "#/$defs/booleanOrExpression",
      "default": false
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "preview": {
      "$ref": "#/$defs/preview"
    },
    "demo_mode": {
      "$ref": "#/$defs/demoMode"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "apps": {
      "$ref": "#/$defs/apps"
    },
    "components": {
      "$ref": "#/$defs/components"
    },
    "tags": {
      "$ref": "#/$defs/tagAssignments"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "expression": {
      "type": "string",
      "pattern": "^\\$\\{\\{\\s*[A-Za-z_][A-Za-z0-9_.]*\\s*}}$"
    },
    "booleanOrExpression": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/expression"
        }
      ]
    },
    "integerOrExpression": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/expression"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/inputDefinition"
      }
    },
    "inputDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "secret": {
          "type": "boolean",
          "default": false
        },
        "default": true
      }
    },
    "identifier": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "enabled": {
          "$ref": "#/$defs/booleanOrExpression",
          "default": true
        },
        "default": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "url": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      }
    },
    "demoMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remove"
      ],
      "properties": {
        "remove": {
          "$ref": "#/$defs/booleanOrExpression"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assign_unstaged"
      ],
      "properties": {
        "assign_unstaged": {
          "$ref": "#/$defs/booleanOrExpression"
        },
        "stage_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ]
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install"
      ],
      "properties": {
        "continue_on_error": {
          "$ref": "#/$defs/booleanOrExpression",
          "default": false
        },
        "install": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentField"
          }
        }
      }
    },
    "componentField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "field",
        "type"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "field_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fieldType": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tab": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pos": {
          "$ref": "#/$defs/integerOrExpression"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "displayName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required": {
          "$ref": "#/$defs/booleanOrExpression",
          "default": false
        },
        "translatable": {
          "$ref": "#/$defs/booleanOrExpression",
          "default": false
        }
      }
    },
    "tagAssignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stories",
          "tags"
        ],
        "properties": {
          "stories": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "ids"
                ]
              },
              {
                "required": [
                  "slugs"
                ]
              }
            ],
            "properties": {
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              },
              "slugs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    }
  }
}
