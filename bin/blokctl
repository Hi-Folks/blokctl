#!/usr/bin/env php
<?php
// Support both standalone (own vendor/) and installed as a Composer dependency
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',       // standalone
    __DIR__ . '/../../../autoload.php',         // installed as dependency
];
foreach ($autoloadPaths as $autoloadPath) {
    if (file_exists($autoloadPath)) {
        require $autoloadPath;
        break;
    }
}

use Blokctl\Command\AssetsListCommand;
use Blokctl\Command\AssetsConvertToGlobalCommand;
use Blokctl\Command\AssetsUnreferencedCommand;
use Blokctl\Command\AppProvisionInstallCommand;
use Blokctl\Command\AppProvisionListCommand;
use Blokctl\Command\SpaceInfoCommand;
use Blokctl\Command\SpaceLanguageAddCommand;
use Blokctl\Command\SpaceLanguageEnsureCommand;
use Blokctl\Command\SpaceLanguageListCommand;
use Blokctl\Command\SpaceLanguageRemoveCommand;
use Blokctl\Command\SpaceCreateCommand;
use Blokctl\Command\SpacePreviewListCommand;
use Blokctl\Command\SpacePreviewSetCommand;
use Blokctl\Command\SpacePreviewAddCommand;
use Blokctl\Command\SpaceDeleteCommand;
use Blokctl\Command\SpaceSetupCommand;
use Blokctl\Command\SpaceSetupValidateCommand;
use Blokctl\Command\FolderCreateCommand;
use Blokctl\Command\FolderDimensionAddCommand;
use Blokctl\Command\SpaceDemoRemoveCommand;
use Blokctl\Command\SpacesListCommand;
use Blokctl\Command\StoriesWorkflowAssignCommand;
use Blokctl\Command\ComponentFieldAddCommand;
use Blokctl\Command\ComponentsListCommand;
use Blokctl\Command\ComponentShowCommand;
use Blokctl\Command\ComponentsUsageCommand;
use Blokctl\Command\ExperimentCreateCommand;
use Blokctl\Command\ExperimentResultsPushCommand;
use Blokctl\Command\ExperimentsListCommand;
use Blokctl\Command\StoriesBulkCreateCommand;
use Blokctl\Command\StoriesListCommand;
use Blokctl\Command\StoriesTagsAssignCommand;
use Blokctl\Command\SpaceTokenCommand;
use Blokctl\Command\StoryCreateCommand;
use Blokctl\Command\StoryFieldSetCommand;
use Blokctl\Command\StoryMoveCommand;
use Blokctl\Command\StoryTranslatedSlugSetCommand;
use Blokctl\Command\StoryUpdateCommand;
use Blokctl\Command\StoryShowCommand;
use Blokctl\Command\StoryVersionsCommand;
use Blokctl\Command\StoryWorkflowChangeCommand;
use Blokctl\Command\UserMeCommand;
use Blokctl\Command\WorkflowsListCommand;
use Blokctl\Command\WorkflowStageShowCommand;
use Symfony\Component\Console\Application;

// Load .env from standalone root or from the project root when installed as dependency
$dotenvPaths = [
    __DIR__ . '/..',              // standalone
    __DIR__ . '/../../../..',     // installed as dependency (vendor/hi-folks/blokctl/bin -> project root)
];
foreach ($dotenvPaths as $dotenvPath) {
    $dotenv = Dotenv\Dotenv::createImmutable($dotenvPath);
    $dotenv->safeLoad();
}
$dotenv = null; // already loaded above

$application = new Application("blokctl", "1.0.0-dev");

$application->addCommand(new AssetsListCommand());
$application->addCommand(new AssetsConvertToGlobalCommand());
$application->addCommand(new AssetsUnreferencedCommand());
$application->addCommand(new AppProvisionInstallCommand());
$application->addCommand(new AppProvisionListCommand());
$application->addCommand(new FolderCreateCommand());
$application->addCommand(new FolderDimensionAddCommand());
$application->addCommand(new SpaceCreateCommand());
$application->addCommand(new SpaceInfoCommand());
$application->addCommand(new SpacePreviewListCommand());
$application->addCommand(new SpacePreviewSetCommand());
$application->addCommand(new SpacePreviewAddCommand());
$application->addCommand(new SpaceDeleteCommand());
$application->addCommand(new SpaceLanguageAddCommand());
$application->addCommand(new SpaceLanguageEnsureCommand());
$application->addCommand(new SpaceLanguageListCommand());
$application->addCommand(new SpaceLanguageRemoveCommand());
$application->addCommand(new SpaceSetupCommand());
$application->addCommand(new SpaceSetupValidateCommand());
$application->addCommand(new SpaceDemoRemoveCommand());
$application->addCommand(new SpaceTokenCommand());
$application->addCommand(new SpacesListCommand());
$application->addCommand(new StoriesWorkflowAssignCommand());
$application->addCommand(new ComponentFieldAddCommand());
$application->addCommand(new ComponentsListCommand());
$application->addCommand(new ComponentShowCommand());
$application->addCommand(new ComponentsUsageCommand());
$application->addCommand(new ExperimentCreateCommand());
$application->addCommand(new ExperimentsListCommand());
$application->addCommand(new ExperimentResultsPushCommand());
$application->addCommand(new StoriesBulkCreateCommand());
$application->addCommand(new StoriesListCommand());
$application->addCommand(new StoriesTagsAssignCommand());
$application->addCommand(new StoryCreateCommand());
$application->addCommand(new StoryFieldSetCommand());
$application->addCommand(new StoryMoveCommand());
$application->addCommand(new StoryTranslatedSlugSetCommand());
$application->addCommand(new StoryUpdateCommand());
$application->addCommand(new StoryShowCommand());
$application->addCommand(new StoryVersionsCommand());
$application->addCommand(new StoryWorkflowChangeCommand());
$application->addCommand(new UserMeCommand());
$application->addCommand(new WorkflowsListCommand());
$application->addCommand(new WorkflowStageShowCommand());

$application->run();
