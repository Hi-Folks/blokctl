SECRET_KEY=your-scoped-personal-access-token

# Optional: space:setup-export secret masking
# Names treated as secrets (comma separated, matched as substrings ignoring case, _ and -)
# BLOKCTL_SECRET_NAMES=token,access_token,secret,client_secret,password,passwd,api_key,private_key,access_key,credential
# Text that replaces secret values in the export
# BLOKCTL_SECRET_PLACEHOLDER=####YOURSECRET####
